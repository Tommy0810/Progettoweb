{
  "name": "lumio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lumio - rotate, connect, glow. A minimalist puzzle game for Android and iOS.",
  "scripts": {
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "test": "node --test tests/*.test.mjs",
    "e2e": "node tests/e2e.mjs",
    "cap:sync": "npx cap sync",
    "android": "npx cap add android; npx cap sync android && npx cap open android",
    "ios": "npx cap add ios; npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor-community/admob": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
